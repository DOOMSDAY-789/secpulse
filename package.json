{
  "name": "secpulse",
  "productName": "SecPulse",
  "version": "1.0.0",
  "description": "Hacked sites, leaked passwords and new PHP/WordPress/MySQL vulnerabilities.",
  "author": "DOOMSDAY-789",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "test": "node test.mjs",
    "start": "python -m http.server 8080",
    "check": "node check.mjs",
    "app": "electron .",
    "exe": "electron-builder --win portable",
    "apk": "node apk.mjs"
  },
  "build": {
    "appId": "io.github.doomsday-789.secpulse",
    "files": [
      "main.js",
      "index.html",
      "app.js",
      "pwned.js",
      "feeds.js",
      "sw.js",
      "manifest.webmanifest",
      "icon-192.png",
      "icon-512.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "icon-512.png"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
